<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme: kengo://magic?t=..., kengo://billing/return?... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kengo" />
            </intent-filter>

            <!-- Android App Links — requiere assetlinks.json servido en
                 https://kengoapp.com/.well-known/assetlinks.json con el
                 SHA-256 de la clave de firma. Hasta entonces autoVerify falla
                 silenciosamente y el OS trata el dominio como link normal.

                 ALLOWLIST, no blacklist. Android no admite exclusiones de ruta
                 (no existe pathNotPrefix), así que en vez de capturar todo el
                 dominio e ir excluyendo, se enumera solo lo que DEBE abrir la
                 app. Todo lo demás — /legal/*, /soporte, /eliminar-cuenta y
                 /billing-return.html — se queda en el navegador, que es
                 justamente donde Apple y Google revisan esas URLs, y lo que
                 billing-return.html necesita para rebotar a
                 kengo://billing/return.

                 Se usa android:path (coincidencia exacta): el query string no
                 forma parte del path, así que /magic?t=... casa con
                 android:path="/magic" sin abrir la puerta a /magic-otra-cosa.
                 Cada <data> lleva scheme+host+path completos porque Android
                 combina los atributos de todos los <data> del filtro.

                 www.kengoapp.com queda fuera a propósito: es la landing y
                 ningún enlace generado por el backend apunta ahí. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="kengoapp.com" android:path="/magic" />
                <data android:scheme="https" android:host="kengoapp.com" android:path="/invitacion" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Icono y color para las notificaciones push (FCM). Sin estas
             meta-data, Android pinta un cuadrado blanco en la status bar. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary"
        />
        <!-- Canal por defecto para pushes que lleguen sin channel_id (p. ej.
             antes de que el JS cree los canales, o durante un rollout con
             backend viejo). Debe coincidir con un canal creado por
             PushNotificationService.ensureAndroidChannels(). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mensajes"
        />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requiere permiso runtime para mostrar notificaciones.
         El plugin @capacitor-firebase/messaging lo solicita vía
         FirebaseMessaging.requestPermissions(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
